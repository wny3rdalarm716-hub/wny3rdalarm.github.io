
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function verified() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function staff() {
      return verified() && exists(/databases/$(database)/documents/staffAccess/$(request.auth.uid)) && get(/databases/$(database)/documents/staffAccess/$(request.auth.uid)).data.active == true;
    }

    function exact(d, fields) {
      return d.keys().hasAll(fields) && d.keys().hasOnly(fields);
    }

    function category(c) {
      return c in ['STRUCTURE FIRE','VEHICLE FIRE','BRUSH FIRE','OUTSIDE FIRE','FIRE'];
    }

    function photos() {
      return ['rescue7','scene','night','engine4','rescue','police'];
    }

    function validSettings(d) {
      return exact(d,['announcement','hiddenPhotos']) &&
        d.announcement in ['none','update','photos','maintenance','thanks'] &&
        d.hiddenPhotos is list &&
        d.hiddenPhotos.size() <= 6 &&
        d.hiddenPhotos.hasOnly(photos());
    }

    function validGallery(d) {
      return exact(d,['order','featured']) &&
        d.order is list &&
        d.order.size() == 6 &&
        d.order.hasAll(photos()) &&
        d.featured in ['auto','rescue7','scene','night','engine4','rescue','police'];
    }

    function validWorkspace(d) {
      return exact(d,['focus','release','checks','updatedAt']) &&
        d.focus in ['general','technology','photography','editorial','organization'] &&
        d.release == '2.7' &&
        d.checks is list &&
        d.checks.size() <= 6 &&
        d.checks.hasOnly(['login','weather','gallery','voting','board','updates']) &&
        d.updatedAt == request.time;
    }

    function validMessage(d) {
      return exact(d,['kind','author','createdAt']) &&
        d.author == request.auth.uid &&
        d.createdAt == request.time &&
        d.kind in ['photo_review','gallery_ready','website_review','app_test','maintenance_done','meeting_plan','thanks'];
    }

    function validDraft(d) {
      return exact(d,['category','author','state','createdAt']) &&
        category(d.category) &&
        d.author == request.auth.uid &&
        d.state == 'pending' &&
        d.createdAt == request.time;
    }

    function eligible(d) {
      return d.state == 'pending' &&
        d.author != request.auth.uid &&
        request.time >= d.createdAt + duration.value(24,'h');
    }

    function validApproval(id) {
      let old = resource.data;
      let next = request.resource.data;
      let published = getAfter(/databases/$(database)/documents/publicHistory/$(id)).data;
      return eligible(old) &&
        exact(next,['category','author','state','createdAt','reviewer','reviewedAt']) &&
        next.diff(old).affectedKeys().hasOnly(['state','reviewer','reviewedAt']) &&
        next.state == 'published' &&
        next.reviewer == request.auth.uid &&
        next.reviewedAt == request.time &&
        published.category == old.category &&
        published.publishedAt == request.time;
    }

    function validPublication(id) {
      let d = request.resource.data;
      let old = get(/databases/$(database)/documents/reviewDrafts/$(id)).data;
      let next = getAfter(/databases/$(database)/documents/reviewDrafts/$(id)).data;
      return exact(d,['category','publishedAt']) &&
        category(d.category) &&
        d.publishedAt == request.time &&
        eligible(old) &&
        old.category == d.category &&
        next.state == 'published' &&
        next.reviewer == request.auth.uid &&
        next.reviewedAt == request.time;
    }

    match /staffAccess/{uid} {
      allow get: if verified() && request.auth.uid == uid;
      allow list, write: if false;
    }

    match /publicSettings/app {
      allow get: if true;
      allow create, update: if staff() && validSettings(request.resource.data);
    }

    match /reviewDrafts/{id} {
      allow read: if staff();
      allow create: if staff() && validDraft(request.resource.data);
      allow update: if staff() && validApproval(id);
      allow delete: if staff() && resource.data.state == 'pending';
    }

    match /publicHistory/{id} {
      allow read: if true;
      allow create: if staff() && validPublication(id);
      allow update: if false;
      allow delete: if staff();
    }

    match /teamBoard/{id} {
      allow get: if staff();
      allow list: if staff() && request.query.limit <= 30;
      allow create: if staff() && validMessage(request.resource.data);
      allow update: if false;
      allow delete: if staff() && resource.data.author == request.auth.uid;
    }

    match /staffWorkspace/{uid} {
      allow get: if staff() && request.auth.uid == uid;
      allow create, update: if staff() && request.auth.uid == uid && validWorkspace(request.resource.data);
      allow list, delete: if false;
    }

    match /gallerySettings/app {
      allow get: if true;
      allow create, update: if staff() && validGallery(request.resource.data);
      allow list, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
// END OF V2.8 RULES
